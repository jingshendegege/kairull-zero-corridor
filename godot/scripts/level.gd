## 房间表：[{"name": String, "rect": Rect2i 格坐标}]，空 = 无房间系统
var rooms: Array = []
## build() 后经过校验的楼梯描述；敌人第一版仍只读取 solid_at()，不会自行走梯。
var stairs: Array[Dictionary] = []

var tilemap: TileMapLayer


func build(p_render: bool = true) -> void:
	# 编辑器/git 可能把文件存成 CRLF，统一成 LF 再切行（否则行尾 CR 会多出一列）
	grid = (active_map if not active_map.is_empty() else MAP_TEXT)\
		.replace("\r\n", "\n").strip_edges().split("\n")
	map_h = grid.size()
	map_w = 0
	for row in grid:
		map_w = maxi(map_w, row.length())
	for i in map_h:
		while grid[i].length() < map_w:
			grid[i] += "."
	world_w = map_w * TS
	world_h = map_h * TS
	_parse_markers()
	rooms = active_rooms.duplicate(true)
	_build_stair_heightfields()
	if p_render:
		_build_tilemap()


## 只接收与 32px 地图网格对齐的偶数级楼梯，避免上下平台出现半格高度。
func _build_stair_heightfields() -> void:
	stairs.clear()
	for raw: Dictionary in active_stairs:
		var left_c := int(raw.get("left_c", -1))
		var bottom_row := int(raw.get("bottom_row", -1))
		var steps := int(raw.get("steps", 0))
		var rise_dir := int(raw.get("rise_dir", 0))
		var top_y := bottom_row * TS - steps * (TS / 2)
		var valid := left_c >= 0 and left_c + steps <= map_w \
				and bottom_row > 0 and bottom_row < map_h \
				and steps > 0 and steps % 2 == 0 \
				and (rise_dir == -1 or rise_dir == 1) and top_y >= 0
		if not valid:
			push_warning("忽略无效楼梯描述: %s" % str(raw))
			continue
		stairs.append({
			"left_c": left_c,
			"bottom_row": bottom_row,
			"steps": steps,
			"rise_dir": rise_dir,
		})


## 提取实体标记；C 是由 LDtk 编译器生成的可击飞货箱，不占碰撞格。
func _parse_markers() -> void:
	enemy_spawns.clear()
	enemy_spawn_kinds.clear()
	prop_spawns.clear()
	door_spawns.clear()
	for r in map_h:
		for c in map_w:
			var ch := grid[r].substr(c, 1)
			var feet := Vector2(c * TS + TS * 0.5, (r + 1) * TS - 0.1)
			match ch:
				"@":
					spawn = feet
					grid[r] = grid[r].substr(0, c) + "." + grid[r].substr(c + 1)
				">":
					exit_point = feet
					grid[r] = grid[r].substr(0, c) + "." + grid[r].substr(c + 1)
				"x":
					enemy_spawns.append(feet)
					enemy_spawn_kinds.append("")
					grid[r] = grid[r].substr(0, c) + "." + grid[r].substr(c + 1)
				"m":
					enemy_spawns.append(feet)
					enemy_spawn_kinds.append("melee")
					grid[r] = grid[r].substr(0, c) + "." + grid[r].substr(c + 1)
				"B":
					prop_spawns.append({"kind": "barrel", "pos": feet})
					grid[r] = grid[r].substr(0, c) + "." + grid[r].substr(c + 1)
				"T":
					prop_spawns.append({"kind": "crt", "pos": feet})
					grid[r] = grid[r].substr(0, c) + "." + grid[r].substr(c + 1)
				"C":
					prop_spawns.append({"kind": "bat_cargo", "pos": feet})
					grid[r] = grid[r].substr(0, c) + "." + grid[r].substr(c + 1)
				"D":
					door_spawns.append(feet)
					grid[r] = grid[r].substr(0, c) + "." + grid[r].substr(c + 1)


func tile_at(cx: int, cy: int) -> String:
	if cy < 0 or cy >= map_h or cx < 0 or cx >= map_w:
		return "."
	return grid[cy].substr(cx, 1)


func is_solid_char(ch: String) -> bool:
	return ch == "#" or ch == "=" or ch == "W"   ## W 窗：实心外墙格，只换渲染


## 世界坐标所在格的 room 索引（无房间表返回 -1）
func room_at(wx: float, wy: float) -> int:
	var cell := Vector2i(floori(wx / TS), floori(wy / TS))
	for i in rooms.size():
		if (rooms[i]["rect"] as Rect2i).has_point(cell):
			return i
	return -1


## 世界坐标点所在格对应的 tile 图集坐标；(-1,-1) = 不渲染
func _tile_coord(ch: String, rx: int, ry: int) -> Vector2i:
	if active_art_style == "quarantine" and ch == "#" \
			and (rx == 0 or rx == map_w - 1 or ry == 0 or ry == map_h - 1):
		# 世界边界只承担碰撞；正式 M01 把不可达外壳压成近黑内部 tile，
		# 不在屏幕底/左右边缘额外画一条会被误读为路线的亮行走面。
		return Vector2i(2, 0)
	if ch == "W":
		# 窗 tile 只存在于塔图集第二行；旧图集没有，遇 W 跳过渲染
		if _is_tower_style():
			return Vector2i(0, 1)
		return Vector2i(-1, -1)
	if not TILE_IDX.has(ch):
		return Vector2i(-1, -1)
	if active_art_style == "quarantine":
		var stair_ti := _quarantine_stair_tile_index(ch, rx, ry)
		if stair_ti >= 0:
			return Vector2i(stair_ti, 0)
	var ti: int = TILE_IDX[ch]
	if ch == "#":
		# 顶部用带亮边的 1，内部用 2
		ti = 2 if tile_at(rx, ry - 1) == "#" else 1
	elif ch == "=":
		# 平台端头：左端 3 / 中段 4 / 右端 5
		var l := tile_at(rx - 1, ry) == "="
		var r := tile_at(rx + 1, ry) == "="
		ti = 3 if not l else (5 if not r else 4)
	return Vector2i(ti, 0)


## 正式检疫站只替换楼梯接口的可视皮肤；碰撞字符与高度场保持原样。
func _quarantine_stair_tile_index(ch: String, rx: int, ry: int) -> int:
	for stair: Dictionary in stairs:
		var left_c := int(stair["left_c"])
		var bottom_row := int(stair["bottom_row"])
		var steps := int(stair["steps"])
		var rise_dir := int(stair["rise_dir"])
		# 梯下地面仍是实心 #，但只显示 12px 薄承重边，不再堆出整排方块。
		if ch == "#" and ry == bottom_row \
				and rx >= left_c and rx <= left_c + steps:
			return 10
		var top_row := bottom_row - ceili(float(steps) * 0.5)
		var interface_c := left_c + steps if rise_dir > 0 else left_c - 1
		# 单格落脚接口使用无端帽中段，避免在楼梯与实体地板间露出黑框。
		if ch == "=" and rx == interface_c and ry == top_row:
			return 4
		# 实心基座的下行梯接口下方属于内部，不再因上方是单向台而多画一块亮地板。
		if ch == "#" and rx == interface_c and ry == top_row + 1:
			return 2
	return -1


func _is_tower_style() -> bool:
	return active_tile_style.get("name", "") == "tower" \
		or active_tileset_path.ends_with("tileset_tower.png")


func solid_at(wx: float, wy: float) -> bool:
	return is_solid_char(tile_at(floori(wx / TS), floori(wy / TS)))


## 查询脚底附近的开放式楼梯踏面；返回世界 Y，找不到时返回 INF。
## 每一级横向 32px、纵向 16px，第一踏板固定为 bottom_y-16。
## max_up/max_down 以当前脚底 reference_y 为基准，可排除其他楼层的重叠楼梯。
func stair_surface_near(wx: float, reference_y: float, max_up: float,
		max_down: float) -> float:
	var best := INF
	for stair: Dictionary in stairs:
		var left_x := float(int(stair["left_c"]) * TS)
		var steps := int(stair["steps"])
		var right_x := left_x + steps * TS
		if wx < left_x or wx >= right_x:
			continue
		var index := clampi(floori((wx - left_x) / TS), 0, steps - 1)
		var rank := index + 1 if int(stair["rise_dir"]) > 0 else steps - index
		var surface_y := float(int(stair["bottom_row"]) * TS - rank * (TS / 2))
		if surface_y < reference_y - maxf(0.0, max_up) \
				or surface_y > reference_y + maxf(0.0, max_down):
			continue
		# 多个脚探针或上下叠层同时命中时先接住更高的表面，避免穿过第一层。
		best = minf(best, surface_y)
	return best


## 下落段 [from_y, to_y] 首次跨过的楼梯踏面；上升时楼梯保持单向、可从下方穿过。
func stair_surface_crossed(wx: float, from_y: float, to_y: float) -> float:
	if to_y < from_y:
		return INF
	var best := INF
	for stair: Dictionary in stairs:
		var left_x := float(int(stair["left_c"]) * TS)
		var steps := int(stair["steps"])
		var right_x := left_x + steps * TS
		if wx < left_x or wx >= right_x:
			continue
		var index := clampi(floori((wx - left_x) / TS), 0, steps - 1)
		var rank := index + 1 if int(stair["rise_dir"]) > 0 else steps - index
		var surface_y := float(int(stair["bottom_row"]) * TS - rank * (TS / 2))
		if surface_y >= from_y - 0.25 and surface_y <= to_y + 0.25:
			best = minf(best, surface_y)
	return best


## 只在下落时挡住的平台（可从下方穿过、可站上）
func is_platform(wx: float, wy: float) -> bool:
	return tile_at(floori(wx / TS), floori(wy / TS)) == "="


## 表面分类：飞溅/污渍特效的接触判断接口。
## 返回 {"kind", "material", "normal"}：
##   kind     —— floor（顶面开放，可站立）/ wall（侧面开放）/ ceiling（底面开放）/
##               platform（单向台 =）/ interior（实心内部）/ none（非实心）
##   material —— concrete（# 地砖）/ metal（= 平台）/ none
##   normal   —— 朝向开放侧的单位向量；interior/none 为 ZERO
## 墙两侧都开放时，法线取离查询点更近的一侧。
func surface_at(wx: float, wy: float) -> Dictionary:
	var cx := floori(wx / TS)
	var cy := floori(wy / TS)
	var ch := tile_at(cx, cy)
	if not is_solid_char(ch):
		return {"kind": "none", "material": "none", "normal": Vector2.ZERO}
	if ch == "=":
		return {"kind": "platform", "material": "metal", "normal": Vector2.UP}
	var open_up := not is_solid_char(tile_at(cx, cy - 1))
	var open_l := not is_solid_char(tile_at(cx - 1, cy))
	var open_r := not is_solid_char(tile_at(cx + 1, cy))
	var open_dn := not is_solid_char(tile_at(cx, cy + 1))
	if open_up:
		return {"kind": "floor", "material": "concrete", "normal": Vector2.UP}
	if open_l and open_r:
		var near_left: bool = (wx - cx * TS) < TS * 0.5
		return {"kind": "wall", "material": "concrete",
				"normal": Vector2.LEFT if near_left else Vector2.RIGHT}
	if open_l:
		return {"kind": "wall", "material": "concrete", "normal": Vector2.LEFT}
	if open_r:
		return {"kind": "wall", "material": "concrete", "normal": Vector2.RIGHT}
	if open_dn:
		return {"kind": "ceiling", "material": "concrete", "normal": Vector2.DOWN}
	return {"kind": "interior", "material": "concrete", "normal": Vector2.ZERO}


func _build_tilemap() -> void:
	tilemap = TileMapLayer.new()
	tilemap.name = "TileMapLayer"
	tilemap.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST   ## 像素风禁用线性采样
	var ts := TileSet.new()
	ts.tile_size = Vector2i(TS, TS)
	var src := TileSetAtlasSource.new()
	src.texture = _build_tileset_texture()
	src.texture_region_size = Vector2i(TS, TS)
	# 图集列数由生成资产决定；正式检疫站新增 tile 10 时不影响旧 10 列图集。
	var atlas_columns := int(src.texture.get_width() / TS)
	for i in range(atlas_columns):
		src.create_tile(Vector2i(i, 0))
	if _is_tower_style():
		# 塔图集第二行：(0,1) 窗 W / (1,1) 门框备件
		src.create_tile(Vector2i(0, 1))
		src.create_tile(Vector2i(1, 1))
	ts.add_source(src, 0)
	tilemap.tile_set = ts
	add_child(tilemap)

	for ry in map_h:
		if active_hide_rows_from >= 0 and ry >= active_hide_rows_from:
			continue
		for rx in map_w:
			var ch := tile_at(rx, ry)
			if ch == ".":
				continue
			var coord := _tile_coord(ch, rx, ry)
			if coord.x < 0:
				continue
			tilemap.set_cell(Vector2i(rx, ry), 0, coord)


## 生成 tilemap 用纹理：
##   默认       —— tileset.png 原样加载；
##   "neon"     —— 复制图集像素，砖体向深紫灰 #2a2438 压暗，顶沿 2px 描霓虹边
##                 （# 顶 tile1 = 品红 #ff4fa3，= 台 tile3/4/5 = 青 #7ec8ff），
##                 只动内存里的副本，tileset.png 与其他地图不受影响；
##   "tower"    —— tileset_tower.png 原样加载（程序绘制成品色，不重染色）；
##   active_tileset_path 非空时优先于风格推断。
func _build_tileset_texture() -> Texture2D:
	var path := active_tileset_path
	if path.is_empty():
		path = "res://assets/clips/tileset_tower.png" if _is_tower_style() \
				else "res://assets/clips/tileset.png"
	var base: Texture2D = load(path)
	if active_tile_style.get("name", "") != "neon":
		return base
	var img := base.get_image()
	img.convert(Image.FORMAT_RGBA8)
	var body := Color("#2a2438")
	var edge_hash := Color("#ff4fa3")   ## 实心砖顶沿：品红
	var edge_plat := Color("#7ec8ff")   ## 悬空平台顶沿：青
	for ty in range(10):
		var edge := Color.TRANSPARENT
		if ty == 1:
			edge = edge_hash
		elif ty >= 3 and ty <= 5:
			edge = edge_plat
		for y in range(TS):
			for x in range(TS):
				var px := img.get_pixel(ty * TS + x, y)
				if px.a < 0.05:
					continue
				if edge.a > 0.0 and y < 2:
					# 顶沿 2px：上排全亮，下排略暗做出厚度
					img.set_pixel(ty * TS + x, y,
							edge if y == 0 else edge.darkened(0.35))
				else:
					img.set_pixel(ty * TS + x, y, px.lerp(body, 0.78))
	return ImageTexture.create_from_image(img)
