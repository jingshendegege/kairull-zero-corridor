        {
          "__identifier": "TacticalObjects",
          "__tile": null,
          "__type": "String",
          "__value": "[{\"id\": \"smoke_1\", \"type\": \"smoke_pickup\", \"pos\": [1776, 863.9], \"room_id\": \"rail_uplink\", \"purpose\": \"光栅后的枪手线：投到枪手脚前，烟内换位；也可留下给双层分拣\", \"solutions\": [\"向目标线抛烟并在烟中推进\", \"保留烟雾，先用货箱或翻滚清线\"]}, {\"id\": \"smoke_2\", \"type\": \"smoke_pickup\", \"pos\": [4400, 863.9], \"room_id\": \"quiet_service\", \"purpose\": \"维修间补给：冲压车间枪手线先遮视，再利用时停过闸\", \"solutions\": [\"向目标线抛烟并在烟中推进\", \"保留烟雾，先用货箱或翻滚清线\"]}, {\"id\": \"smoke_3\", \"type\": \"smoke_pickup\", \"pos\": [7280, 1023.9], \"room_id\": \"coolant_lower\", \"purpose\": \"转运前补给：交叉货箱线需要接近时烟幕覆盖低路\", \"solutions\": [\"向目标线抛烟并在烟中推进\", \"保留烟雾，先用货箱或翻滚清线\"]}, {\"id\": \"smoke_4\", \"type\": \"smoke_pickup\", \"pos\": [9008, 863.9], \"room_id\": \"safe_observatory\", \"purpose\": \"狙击桥前补给：向桥中央抛烟，可与上层维护步道互换路线\", \"solutions\": [\"向目标线抛烟并在烟中推进\", \"保留烟雾，先用货箱或翻滚清线\"]}, {\"id\": \"smoke_5\", \"type\": \"smoke_pickup\", \"pos\": [11696, 1023.9], \"room_id\": \"pump_descent\", \"purpose\": \"上行前补给：烟内挥棒起箱，不要求先等满时间能量\", \"solutions\": [\"向目标线抛烟并在烟中推进\", \"保留烟雾，先用货箱或翻滚清线\"]}, {\"id\": \"smoke_6\", \"type\": \"smoke_pickup\", \"pos\": [12976, 863.9], \"room_id\": \"uplink_rise\", \"purpose\": \"最后火线补给：对准终端狙击线抛烟，保护最后一段接近\", \"solutions\": [\"向目标线抛烟并在烟中推进\", \"保留烟雾，先用货箱或翻滚清线\"]}, {\"id\": \"laser_1\", \"type\": \"laser_gate\", \"pos\": [2144, 810], \"span\": 128, \"floor_y\": 864, \"height\": 54, \"room_id\": \"laser_inspection\", \"purpose\": \"短光栅：翻滚低身穿过；或冻结光栅后绕/冲\", \"solutions\": [\"翻滚降低受击框从束线下方穿过\", \"警示时停/等待休止窗后直接跑过\"]}, {\"id\": \"laser_2\", \"type\": \"laser_gate\", \"pos\": [6720, 970], \"span\": 128, \"floor_y\": 1024, \"height\": 54, \"room_id\": \"coolant_lower\", \"purpose\": \"冷却池高路出口：从维护步道跳下绕过束线或贴地翻滚\", \"solutions\": [\"翻滚降低受击框从束线下方穿过\", \"警示时停/等待休止窗后直接跑过\"]}, {\"id\": \"laser_3\", \"type\": \"laser_gate\", \"pos\": [12064, 970], \"span\": 160, \"floor_y\": 1024, \"height\": 54, \"room_id\": \"uplink_rise\", \"purpose\": \"上行搬运前节奏检查：可观察关闭窗，不强迫消耗时停\", \"solutions\": [\"翻滚降低受击框从束线下方穿过\", \"警示时停/等待休止窗后直接跑过\"]}, {\"id\": \"press_1\", \"type\": \"press\", \"pos\": [5024, 672], \"width\": 64, \"floor_y\": 864, \"room_id\": \"press_foundry\", \"purpose\": \"冲压口前留平地和货箱，不在楼梯踏面叠机关\", \"solutions\": [\"提前冻结冲压节拍后通过\", \"观察回程安全窗，直接跑或冲刺过去\"]}, {\"id\": \"press_2\", \"type\": \"press\", \"pos\": [10592, 672], \"width\": 64, \"floor_y\": 864, \"room_id\": \"pump_descent\", \"purpose\": \"冲压口前留平地和货箱，不在楼梯踏面叠机关\", \"solutions\": [\"提前冻结冲压节拍后通过\", \"观察回程安全窗，直接跑或冲刺过去\"]}, {\"id\": \"sniper_1\", \"type\": \"auto_sniper\", \"pos\": [10288, 863.9], \"direction\": [-1, 0], \"range\": 992, \"hard_only\": true, \"room_id\": \"sniper_bridge\", \"purpose\": \"后段才出现的慢速预警/高速弹道，近侧有烟雾和可选上路\", \"solutions\": [\"预警时抛烟，进入烟中避枪\", \"翻滚穿过高弹线，或用时停跨线/维护步道换高度\", \"杀清本房小兵后狙击机关停机，无需破坏炮台\"]}, {\"id\": \"sniper_2\", \"type\": \"auto_sniper\", \"pos\": [14128, 863.9], \"direction\": [-1, 0], \"range\": 992, \"hard_only\": false, \"room_id\": \"terminal_crossfire\", \"purpose\": \"后段才出现的慢速预警/高速弹道，近侧有烟雾和可选上路\", \"solutions\": [\"预警时抛烟，进入烟中避枪\", \"翻滚穿过高弹线，或用时停跨线/维护步道换高度\", \"杀清本房小兵后狙击机关停机，无需破坏炮台\"]}, {\"id\": \"lift_1\", \"type\": \"freight_lift\", \"pos\": [3600, 864], \"top_y\": 672, \"width\": 96, \"height\": 12, \"travel_time\": 2.8, \"dwell\": 1.2, \"room_id\": \"split_sorting\", \"purpose\": \"下层货运线与192px高上廊之间的可乘货梯，绕后击飞上层货箱\", \"solutions\": [\"乘升降货梯进入上层连廊，从侧面接近高位枪手\", \"不等电梯，沿左侧96px中继步道分两次普通跳跃上廊\"]}, {\"id\": \"lift_2\", \"type\": \"freight_lift\", \"pos\": [9584, 864], \"top_y\": 672, \"width\": 96, \"height\": 12, \"travel_time\": 2.8, \"dwell\": 1.2, \"room_id\": \"sniper_bridge\", \"purpose\": \"下层货运线与192px高上廊之间的可乘货梯，绕后击飞上层货箱\", \"solutions\": [\"乘升降货梯进入上层连廊，从侧面接近高位枪手\", \"不等电梯，沿左侧96px中继步道分两次普通跳跃上廊\"]}]",
